{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Wikipedia",
  "version": "1.9.5",
  "identifier": "com.ai-wikipedia.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Wikipedia",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"]
  }
}
