}

#[derive(Serialize, Deserialize)]
// Background nightly sync worker
async fn run_nightly_sync(app_handle: tauri::AppHandle) {
    let mut interval = interval(Duration::from_secs(3600 * 24)); // 24 hours
    
    loop {
        interval.tick().await;
        
        log::info!("Starting nightly article sync...");
        
        let config = load_sync_config(&app_handle).await;
        if !config.enabled {
            log::info!("Nightly sync disabled in config");
            continue;
        }
        
        let mut titles: Vec<(String, String)> = Vec::new();
        
        // Pipe A: Fetch today's featured content
        if config.news_enabled {
            match fetch_featured_articles().await {
                Ok(new_titles) => {
                    log::info!("Fetched {} featured articles", new_titles.len());
                    for title in new_titles {
                        titles.push((title, "news".to_string()));
                    }
                }
                Err(e) => log::error!("Failed to fetch featured: {}", e),
            }
        }
        
        // Pipe B: Random walk for knowledge expansion
        if config.random_enabled {
            for _ in 0..config.max_articles_per_sync.min(5) {
                match fetch_random_article().await {
                    Ok(title) => {
                        titles.push((title, "random".to_string()));
                    }
                    Err(e) => log::error!("Failed to fetch random: {}", e),
                }
                tokio::time::sleep(Duration::from_secs(2)).await; // Rate limiting
            }
        }
        
        // Add to sync queue
        match add_to_queue(&app_handle, titles.clone()).await {
            Ok(count) => {
                log::info!("Added {} articles to sync queue", count);
                
                // Emit event to frontend
                let _ = app_handle.emit_all("sync-queue-updated", serde_json::json!({
                    "count": count,
                    "articles": titles.iter().map(|(t, s)| serde_json::json!({"title": t, "source": s})).collect::<Vec<_>>()
                }));
            }
            Err(e) => log::error!("Failed to add to queue: {}", e),
        }
        
        // Update last sync time
        let mut config = load_sync_config(&app_handle).await;
        config.last_sync = Some(Utc::now().to_rfc3339());
        save_sync_config(&app_handle, &config).await.ok();
        
        log::info!("Nightly sync completed");
    }
}

// Load sync config helper
async fn load_sync_config(app: &tauri::AppHandle) -> SyncConfig {
    let data_dir = get_data_dir(app);
    let config_path = data_dir.join(SYNC_CONFIG_FILENAME);
    
    if !config_path.exists() {
        return SyncConfig::default();
    }
    
    match fs::read_to_string(&config_path) {
        Ok(json) => serde_json::from_str(&json).unwrap_or_default(),
        Err(_) => SyncConfig::default(),
    }
}

