fn main() {
    env_logger::init();
    
    tauri::Builder::default()
        .plugin(tauri_plugin_dialog::init())
        .plugin(tauri_plugin_fs::init())
        .plugin(tauri_plugin_shell::init())
        .setup(|app| {
            let window = app.get_webview_window("main").unwrap();
            window.set_title("AI Wikipedia v1.4.0 - Powered by Ollama").ok();
            
            get_data_dir(&app.handle());
            log::info!("Storage initialized at {:?}", app.path().app_data_dir().ok());
            
            // Start nightly sync worker
            let app_handle = app.handle().clone();
            tauri::async_runtime::spawn(run_nightly_sync(app_handle));
            
            Ok(())
        })
        .invoke_handler(tauri::generate_handler![
            compress_lz4,
            decompress_lz4,
            compress_zstd,
            decompress_zstd,
            save_wikipedia_chunk,
            load_wikipedia_chunk,
            save_manifest,
            load_manifest,
            get_storage_stats,
            get_article_count,
            scrape_webpage,
            parse_document,
            get_sync_config,
            save_sync_config,
            get_sync_queue,
            clear_sync_queue,
            trigger_sync,
        ])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}

