#[tauri::command]
async fn trigger_sync(app: AppHandle) -> Result<String, String> {
    let config = load_sync_config(&app).await;
    if !config.enabled {
        return Err("Nightly sync is disabled".to_string());
    }
    
    let mut titles: Vec<(String, String)> = Vec::new();
    
    // Fetch featured articles
    if config.news_enabled {
        match fetch_featured_articles().await {
            Ok(new_titles) => {
                for title in new_titles {
                    titles.push((title, "news".to_string()));
                }
            }
            Err(e) => log::error!("Failed to fetch featured: {}", e),
        }
    }
    
    // Fetch random articles
    if config.random_enabled {
        for _ in 0..config.max_articles_per_sync.min(5) {
            match fetch_random_article().await {
                Ok(title) => {
                    titles.push((title, "random".to_string()));
                }
                Err(e) => log::error!("Failed to fetch random: {}", e),
            }
            tokio::time::sleep(Duration::from_secs(2)).await;
        }
    }
    
    // Add to queue
    match add_to_queue(&app, titles.clone()).await {
        Ok(count) => {
            // Emit event to frontend
            let _ = app.emit_all("sync-queue-updated", serde_json::json!({
                "count": count,
                "articles": titles.iter().map(|(t, s)| serde_json::json!({"title": t, "source": s})).collect::<Vec<_>>()
            }));
            
            Ok(format!("Added {} articles to sync queue", count))
        }
        Err(e) => Err(format!("Failed to add to queue: {}", e)),
    }
}

#[tauri::command]
async fn scrape_webpage(url: String) -> Result<String, String> {
    let client = reqwest::Client::new();
    let response = client
        .get(&url)
        .header("User-Agent", "Mozilla/5.0 (compatible; AI-Wikipedia/1.0)")
        .send()
        .await
        .map_err(|e| format!("Request failed: {}", e))?;
    
    let html = response.text().await.map_err(|e| format!("Failed to read response: {}", e))?;
    
    let re = regex::Regex::new(r"<[^>]+>").unwrap();
    let text = re.replace_all(&html, " ");
    let text = text.replace("  ", " ").replace("  ", " ");
    
    Ok(text.chars().take(5000).collect())
}
