// Fetch today's featured content from Wikipedia
async fn fetch_featured_articles() -> Result<Vec<String>, String> {
    let client = reqwest::Client::new();
    let now = Utc::now();
    let url = format!("{}/{}/{}/{}", WIKI_FEATURED_API, now.year(), 
                     format!("{:02}", now.month() as u32), format!("{:02}", now.day()));
    
    let response = client
        .get(&url)
        .header("User-Agent", "AI-Wikipedia/1.0")
        .send()
        .await
        .map_err(|e| format!("Failed to fetch featured: {}", e))?;
    
    if !response.status().is_success() {
        return Err(format!("Featured API returned: {}", response.status()));
    }
    
    let data: serde_json::Value = response
        .json()
        .await
        .map_err(|e| format!("Failed to parse featured JSON: {}", e))?;
    
    let mut titles = Vec::new();
    
    // Extract "in the news" titles
    if let Some(news) = data.get("news") {
        if let Some(items) = news.as_array() {
            for item in items {
                if let Some(title) = item.get("title") {
                    if let Some(t) = title.as_str() {
                        titles.push(t.to_string());
                    }
                }
            }
        }
    }
    
    Ok(titles)
}

// Fetch a random Wikipedia article title
async fn fetch_random_article() -> Result<String, String> {
    let client = reqwest::Client::new();
    let response = client
        .get(WIKI_RANDOM_URL)
        .header("User-Agent", "AI-Wikipedia/1.0")
        .send()
        .await
        .map_err(|e| format!("Failed to fetch random: {}", e))?;
    
    // Get the final URL after redirects - it contains the article title
    if let Some(location) = response.url().path_segments() {
        let title = location.last().unwrap_or("").replace("_", " ");
        if !title.is_empty() {
            return Ok(title);
        }
    }
    
    Err("Failed to extract title from random article URL".to_string())
}

