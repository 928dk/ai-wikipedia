#[tauri::command]
async fn get_storage_stats(app: AppHandle) -> Result<StorageStats, String> {
    let wiki_dir = get_data_dir(&app);
    let mut total_compressed = 0;
    let mut total_original = 0;
    let mut file_count = 0;
    
    if wiki_dir.exists() {
        for entry in fs::read_dir(&wiki_dir).map_err(|e| e.to_string())? {
            let entry = entry.map_err(|e| e.to_string())?;
            let path = entry.path();
            if path.is_file() {
                let size = fs::metadata(&path).map_err(|e| e.to_string())?.len() as usize;
                total_compressed += size;
                file_count += 1;
            }
        }
    }
    
    let manifest = load_manifest(app).await?;
    if let Some(m) = manifest {
        total_original = m.chunks.iter().map(|c| c.original_size).sum();
    }
    
    Ok(StorageStats {
        total_compressed,
        total_original,
        file_count,
        compression_ratio: if total_original > 0 {
            total_compressed as f64 / total_original as f64
        } else {
            0.0
        },
    })
}

#[derive(Serialize)]
struct StorageStats {
    total_compressed: usize,
    total_original: usize,
    file_count: usize,
    compression_ratio: f64,
}

#[tauri::command]
async fn parse_document(path: String, parser_type: String) -> Result<String, String> {
    use std::process::Command;
    use std::path::Path;
    
    // Try to find the parser script
    let script_paths = vec![
        "src-tauri/parsers/document_parser.py".to_string(),
        "$HOME/projects/Client/ai-wikipedia/src-tauri/parsers/document_parser.py".to_string(),
    ];
    
    let script_path = script_paths.iter()
        .find(|p| Path::new(p).exists())
        .ok_or_else(|| "Parser script not found".to_string())?;
    
    // Auto-detect parser type if not specified
    let output = if parser_type.is_empty() {
        Command::new("python3")
            .args(&[script_path.as_str(), &path])
            .output()
    } else {
        Command::new("python3")
            .args(&[script_path.as_str(), &path, &parser_type])
            .output()
    };
    
    match output {
        Ok(out) => {
            if out.status.success() {
                String::from_utf8(out.stdout)
                    .map_err(|e| format!("UTF-8 error: {}", e))
            } else {
                let err = String::from_utf8_lossy(&out.stderr);
                Err(format!("Parse error: {}", err))
            }
        }
        Err(e) => Err(format!("Failed to run parser: {}", e)),
    }
}



#[tauri::command]
async fn get_article_count(app: AppHandle) -> Result<usize, String> {
    let wiki_dir = get_data_dir(&app);
